{
   "content_scripts": [ {
      "exclude_globs": [  ],
      "exclude_matches": [  ],
      "include_globs": [ "*" ],
      "js": ["global.js", "script.js"],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_idle"
   } ],
   "background": {
      "scripts": ["submitChecker.js"]
   },
   "permissions": [
		"http://*/",
		"https://*/",
		"tabs",
		"cookies",
		"storage"
   ],
   "icons": {"19":"BlackMage-ff1-psp.png",
			 "19":"FFI_PSP_White_Wizard_Map.png",
			 "19":"daveImg.png"}
   ,   
   "browser_action": {
    "default_title": "Submission Checker",      // optional; shown in tooltip
    "default_popup": "popup.html"        // optional
   },
   "converted_from_user_script": false,
   "description": "",
   "name": "Submit Checker(2.0)",
   "version": "1.0",
   "manifest_version": 2
}
