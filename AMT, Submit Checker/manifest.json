{
   "content_scripts": [ {
      "exclude_globs": [  ],
      "exclude_matches": [  ],
      "include_globs": [ "https://*.mturk.com/mturk/*" ],
      "js": [ "script.js" ],
      "matches": [ "http://*/*", "https://*/*" ],
      "run_at": "document_idle"
   } ],
   "background": {
      "scripts": ["submitChecker.js"]
   },
   "permissions": [
		"http://*/",
		"https://*/",
		"history"
   ],
   "browser_action": {
    "default_icon": {                    // optional
      "19": "BlackMage-ff1-psp.png",           // optional
      "38": "BlackMage-ff1-psp.png"            // optional
    },
    "default_title": "Submission Checker",      // optional; shown in tooltip
    "default_popup": "popup.html"        // optional
   },
   "converted_from_user_script": false,
   "description": "",
   "key": "asdfddsa",
   "name": "Submit Checker(woot)",
   "version": "1.0",
   "manifest_version": 2
}
